// Bounded RESP2 key/value storage and synchronous table operations.
// The caller preallocates a fixed table of these slots. Their byte fields keep
// physical extents for the lifetime of the table. Logical lengths and the
// occupied bit describe the currently published value without allocating.

namespace redis_server.store

using holo.bytes

// One stable slot in the request handler's bounded table.
public struct Slot {
    // A present empty value still occupies its slot.
    occupied bool
    // Number of live bytes in the key field.
    key_length u64
    // Number of live bytes in the value field.
    value_length u64
    // Inline capacity for a binary key. Only the logical prefix is exposed.
    key Bytes
    // Inline capacity for a binary value. Updates replace the logical prefix.
    value Bytes
}

// Construct a free, fully initialized slot in the caller's final table.
// The caller handles bounded destination reservation failure at append.
public func empty_slot
    with noblock
    arg key_capacity u64 as readonly copy
    arg value_capacity u64 as readonly copy
    returns Slot
{
    return Slot {
        occupied: false,
        key_length: 0,
        value_length: 0,
        key: core.bytes(key_capacity, 0),
        value: core.bytes(value_capacity, 0)
    }
}

public error PutError {
    Full
    OverLimit
}

// Return Some(index) for an occupied matching key and None for a miss.
// The lookup reads only the logical key prefixes, including an empty key.
public func find
    with noalloc, noblock
    arg entries Batch<Slot> as readonly reference
    arg key Bytes as readonly reference
    returns Option<u64>
{
    return find_slot(entries, key, false)
}

// Find a matching slot, or the first free slot when inserting. A full table
// with no match and a lookup miss both return None. Each call scans once.
func find_slot
    with noalloc, noblock
    arg entries Batch<Slot> as readonly reference
    arg key Bytes as readonly reference
    arg inserting bool as readonly copy
    returns Option<u64>
{
    var first_free = 0
    var found_free = false
    var index = 0
    for readonly entry in entries {
        if not entry.occupied {
            if not found_free {
                first_free = index
                found_free = true
            }
        } else {
            if entry.key_length == core.len(key) {
                if bytes.equal(core.prefix(entry.key, entry.key_length), key) {
                    return Some(index)
                }
            }
        }
        index = core.add_wrapping(index, 1)
    }
    if inserting and found_free {
        return Some(first_free)
    }
    return None
}

// Replace or insert a pair of binary views from the caller's request buffer.
// That buffer is separate from the table. Validate both destination extents
// before writing and keep the old value on failure.
public func put
    with noalloc, noblock
    arg entries Batch<Slot> as readwrite reference
    arg key Bytes as readonly reference
    arg value Bytes as readonly reference
    returns Result<u64, PutError>
{
    find_slot(entries, key, true)
        on Some(index) then {
            let destination = core.borrow_readwrite(entries, index)
            if core.len(key) > core.len(destination.key) {
                return error PutError.OverLimit
            }
            if core.len(value) > core.len(destination.value) {
                return error PutError.OverLimit
            }
            if not destination.occupied {
                destination.key_length = bytes.move(destination.key, key)
            }
            destination.value_length = bytes.move(destination.value, value)
            destination.occupied = true
            return ok index
        }
        on None then {
            return error PutError.Full
        }
}
