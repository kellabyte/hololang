// Bounded RESP2 GET and SET server. The checked parser commits scalar request
// extents, the table owns copied keys and values, and the entry sends replies
// over a host-owned connected stream. Each stage uses finite backing.

using redis_server.store

// Parse a bounded RESP2 GET or SET request from the caller's live byte
// prefix. The parser never copies payloads or keeps a borrowed view. It
// publishes copied offsets in one fixed record only after the complete
// request passes length, delimiter, command, and arity checks.

// Completed request metadata in the caller's reusable record.
struct Request {
    // One for GET, two for SET, and zero before the first success.
    command u64
    // Wire bytes consumed starting from the request's first byte.
    consumed u64
    // Absolute offset in the supplied byte view of the validated key.
    key_offset u64
    // Binary key length, including the possibility of an empty key.
    key_length u64
    // Absolute value offset for SET, or zero for GET.
    value_offset u64
    // Binary value length for SET, or zero for GET.
    value_length u64
}

// Initialize one metadata record at its receiving destination. The caller
// keeps this storage across requests. There is no variable-sized field.
func empty_request
    with noblock
    returns Request
{
    return Request {
        command: 0,
        consumed: 0,
        key_offset: 0,
        key_length: 0,
        value_offset: 0,
        value_length: 0
    }
}

// Read a canonical unsigned decimal header after the expected marker.
// Return the value after validating CRLF or a status above 512. All callers
// bound the input view to 512 bytes and the successful value to 128. The
// caller selects the over-limit status for shape and payload-size failures.
func request_decimal
    with noalloc, noblock
    arg wire Bytes as readonly reference
    arg start u64 as readonly copy
    arg marker u64 as readonly copy
    arg limit u64 as readonly copy
    arg over_limit u64 as readonly copy
    returns u64
{
    let extent = core.len(wire)
    // An empty suffix can acquire the marker on the next read.
    if start >= extent {
        return core.add_wrapping(1025, start)
    }
    if wire[start] != marker {
        return 2048
    }
    let first = core.add_wrapping(start, 1)
    var value = 0
    // The checked marker ensures first <= extent. Each iteration stays
    // inside the logical view, and CR ends the scan before any payload read.
    for index in core.range(core.sub_wrapping(extent, first)) {
        let position = core.add_wrapping(first, index)
        let byte = wire[position]
        if byte == 13 {
            // Require at least one digit and an available, matching LF.
            if index == 0 {
                return 2048
            }
            let line_end = core.add_wrapping(position, 1)
            if line_end == extent {
                return core.add_wrapping(1025, extent)
            }
            if wire[line_end] != 10 {
                return 2048
            }
            if value > limit {
                return over_limit
            }
            return value
        }
        // Request sizes admit ASCII decimal digits and canonical zero only.
        // Rejecting a second digit after zero also makes header widths derivable.
        if byte < 48 {
            return 2048
        }
        if byte > 57 {
            return 2048
        }
        if index != 0 {
            if value == 0 {
                return 2048
            }
        }
        let digit = core.sub_wrapping(byte, 48)
        // UINT64_MAX / 10 and its remainder bound both operations before
        // applying wrapping primitives to this nonwrapping decimal result.
        if value > 1844674407370955161 {
            return 2050
        }
        if value == 1844674407370955161 {
            if digit > 5 {
                return 2050
            }
        }
        value = core.add_wrapping(core.mul_wrapping(value, 10), digit)
    }
    return core.add_wrapping(1025, extent)
}

// Check a complete bulk string's body extent and trailing CRLF, then return
// its payload offset or a status above 512. Length is already validated and
// at most 128. Its canonical decimal width avoids a second scan. Body bytes
// can be arbitrary.
func request_bulk_payload
    with noalloc, noblock
    arg wire Bytes as readonly reference
    arg header u64 as readonly copy
    arg length u64 as readonly copy
    returns u64
{
    // A validated header is dollar, one to three digits, and CRLF.
    var payload = core.add_wrapping(header, 4)
    if length >= 10 {
        payload = core.add_wrapping(payload, 1)
    }
    if length >= 100 {
        payload = core.add_wrapping(payload, 1)
    }
    let ending = core.add_wrapping(payload, length)
    let next = core.add_wrapping(ending, 2)
    let extent = core.len(wire)
    // Inspect the first trailer byte as soon as it is live. A malformed
    // partial trailer can therefore fail before the next byte arrives.
    if extent <= ending {
        return core.add_wrapping(1024, next)
    }
    if wire[ending] != 13 {
        return 2048
    }
    if extent < next {
        return core.add_wrapping(1024, next)
    }
    if wire[core.add_wrapping(ending, 1)] != 10 {
        return 2048
    }
    return payload
}

// Parse one request starting at an absolute position in the live view. Keep
// request untouched on every failure. Success returns the positive consumed
// extent (1–512) and publishes absolute key and value offsets in the supplied
// record. A status from 1025 through 2047 encodes the absolute extent required
// plus 1024. 2048 is malformed, 2049 is over limit, and 2050 is decimal overflow.
// The ordinary writable-state ABI returns u64. It performs no I/O, allocation,
// payload copy, or retained borrow.
func parse_request
    with noalloc, noblock
    arg request Request as readwrite reference
    arg wire Bytes as readonly reference
    arg start u64 as readonly copy
    returns u64
{
    let extent = core.len(wire)
    // A bounded view limits all cursor arithmetic independently of declared
    // wire lengths. A caller may parse an empty suffix at exactly extent.
    if extent > 512 {
        return 2049
    }
    if start > extent {
        return 2048
    }
    let count = request_decimal(wire, start, 42, 3, 2048)
    // Propagate framing and extent failures before using the array count.
    // Only the canonical one-digit array counts of GET and SET are admitted.
    if count > 512 {
        return count
    }
    if count < 2 {
        return 2048
    }
    let command_header = core.add_wrapping(start, 4)
    let command_length = request_decimal(wire, command_header, 36, 3, 2048)
    // Both commands have exactly three bytes and the same framing overhead.
    if command_length > 512 {
        return command_length
    }
    if command_length != 3 {
        return 2048
    }
    let command_start = request_bulk_payload(wire, command_header, command_length)
    if command_start > 512 {
        return command_start
    }
    // Clearing ASCII bit five admits only the two cases of each named
    // command byte. The payload and its delimiter have already been checked.
    var command = 1
    var first_letter = 71
    if count == 3 {
        command = 2
        first_letter = 83
    }
    if core.and(wire[command_start], 223) != first_letter {
        return 2048
    }
    if core.and(wire[core.add_wrapping(command_start, 1)], 223) != 69 {
        return 2048
    }
    if core.and(wire[core.add_wrapping(command_start, 2)], 223) != 84 {
        return 2048
    }

    let key_header = core.add_wrapping(command_start, 5)
    let key_length = request_decimal(wire, key_header, 36, 32, 2049)
    // Validate key framing before computing the value's header offset.
    if key_length > 512 {
        return key_length
    }
    let key_offset = request_bulk_payload(wire, key_header, key_length)
    if key_offset > 512 {
        return key_offset
    }
    let after_key = core.add_wrapping(core.add_wrapping(key_offset, key_length), 2)
    var value_offset = 0
    var value_length = 0
    var after_request = after_key
    // SET admits exactly one value. GET publishes zero in both value fields.
    if command == 2 {
        let parsed_length = request_decimal(wire, after_key, 36, 128, 2049)
        if parsed_length > 512 {
            return parsed_length
        }
        let parsed_offset = request_bulk_payload(wire, after_key, parsed_length)
        if parsed_offset > 512 {
            return parsed_offset
        }
        value_length = parsed_length
        value_offset = parsed_offset
        after_request = core.add_wrapping(core.add_wrapping(parsed_offset, parsed_length), 2)
    }

    // Every body and trailer has been validated. Publish together at this
    // boundary so incomplete and terminal errors cannot alter caller state.
    let consumed = core.sub_wrapping(after_request, start)
    request.command = command
    request.consumed = consumed
    request.key_offset = key_offset
    request.key_length = key_length
    request.value_offset = value_offset
    request.value_length = value_length
    return consumed
}

// The parser declarations above also serve the offline conformance driver.

// Buffers remain initialized and retain their physical extent across requests.
// Logical input/output cursors separately delimit the valid bytes.
struct WireSlot {
    // Inline byte capacity, filled once during owner setup.
    wire Bytes
}

// Construct one initialized buffer directly in its long-lived receiving slot.
func wire_slot
    arg capacity u64 as readonly copy
    returns WireSlot
{
    return WireSlot {
        wire: core.bytes(capacity, 0)
    }
}

// Serve one connected stream at a time while keeping the table alive for the
// whole entry. No request acquires backing. Short I/O and per-client parsing
// state live in scalars, and replies finish before input can reuse the buffers.
func main
    returns u64
{
    let wire_capacity = 512
    let key_capacity = 32
    let value_capacity = 128
    let entries_capacity = 16

    let buffers_memory = core.region(2048) else {
        core.assert(false);
        return 0
    }
    let buffers = core.batch(buffers_memory, WireSlot)
    let input_status = core.append(buffers, wire_slot(wire_capacity))
    let pending_status = core.append(buffers, wire_slot(wire_capacity))
    // A maximum bulk reply has six header bytes, 128 data bytes, and CRLF.
    let output_status = core.append(buffers, wire_slot(136))
    core.assert(input_status == 0)
    core.assert(pending_status == 0)
    core.assert(output_status == 0)
    let incoming = core.borrow_readwrite(buffers, 0)
    let pending = core.borrow_readwrite(buffers, 1)
    let reply = core.borrow_readwrite(buffers, 2)

    let request_memory = core.region(64) else {
        core.assert(false);
        return 0
    }
    let requests = core.batch(request_memory, Request)
    let request_status = core.append(requests, empty_request())
    core.assert(request_status == 0)
    let request = core.borrow_readwrite(requests, 0)

    let table_memory = core.region(4096) else {
        core.assert(false);
        return 0
    }
    let entries = core.batch(table_memory, store.Slot)
    // Initialize all slots once. Updates mutate a checked prefix in place.
    for index in core.range(entries_capacity) {
        let status = core.append(entries, store.empty_slot(key_capacity, value_capacity))
        core.assert(status == 0)
    }

    let interrupted = 18446744073709551615
    let would_block = 18446744073709551614
    var filled = 0
    var cursor = 0
    var sent = 0
    var reply_length = 0
    var close_after_reply = 0
    var session_finished = 0
    loop {
        // Advancing the session discards only stream state. A prior SET
        // remains committed even if the peer never read its reply.
        if session_finished == 1 {
            let next = core.next_session()
            if next == 0 {
                filled = 0
                cursor = 0
                sent = 0
                reply_length = 0
                close_after_reply = 0
                session_finished = 0
            } else {
                // An interrupted accept can retry. A borrowed single stream
                // reports end here and the entry releases all backing.
                if next != interrupted {
                    return 0
                }
            }
        } else {
            // A partially written reply owns the output slot until all its
            // bytes are accepted or the session terminates.
            if sent < reply_length {
                let remaining = core.sub_wrapping(reply_length, sent)
                let outcome = core.send(reply.wire, sent, remaining)
                if outcome <= remaining {
                    core.assert(outcome != 0)
                    sent = core.add_wrapping(sent, outcome)
                } else {
                    if outcome == would_block {
                        let ready = core.wait_output()
                        if ready != 0 {
                            if ready != interrupted {
                                session_finished = 1
                            }
                        }
                    } else {
                        // Preserve the pending offset across EINTR.
                        if outcome != interrupted {
                            session_finished = 1
                        }
                    }
                }
            } else {
                if close_after_reply == 1 {
                    session_finished = 1
                } else {
                    // Bytes before cursor belong to completed requests. Keep
                    // all pending bytes in place unless a new read needs room.
                    if cursor == filled {
                        cursor = 0
                        filled = 0
                    }
                    var read_needed = 1
                    var reply_error = 0
                    if cursor < filled {
                        let outcome = parse_request(request, core.prefix(pending.wire, filled), cursor)
                        if outcome <= wire_capacity {
                            core.assert(outcome > 0)
                            read_needed = 0
                            cursor = core.add_wrapping(cursor, outcome)

                            // Dispatch one checked request against a preallocated table. The caller
                            // supplies entries, request, pending.wire, filled, key_capacity, and
                            // value_capacity. Keep match_index and store_result for reply formatting.
                            // Statuses are 0 stored, 1 found, 2 missing, 3 table full, and 4 invalid extent.
                            let slot_count = core.len(entries)
                            var match_index = slot_count
                            var free_index = slot_count
                            var store_result = 4
                            let key_in_range = store.range_fits(core.prefix(pending.wire, filled), request.key_offset, request.key_length)
                            // Validate the requested key against both the received extent and the table's
                            // shape before selecting an entry. Empty keys remain legal.
                            if key_in_range == 1 {
                                if request.key_length <= key_capacity {
                                    var index = 0
                                    // Search the fixed published prefix. Save scalar indexes, so no
                                    // reference from a loop iteration can outlive that iteration.
                                    for readonly entry in entries {
                                        // Record the first free slot, or compare an occupied key of the
                                        // same logical length. The published table contains unique keys.
                                        if entry.occupied == 0 {
                                            if free_index == slot_count {
                                                free_index = index
                                            }
                                        } else {
                                            if entry.key_length == request.key_length {
                                                if store.key_matches(entry.key, pending.wire, request.key_offset, request.key_length) == 1 {
                                                    match_index = index
                                                }
                                            }
                                        }
                                        index = core.add_wrapping(index, 1)
                                    }
                                    // A GET does not change the table. Its selected value remains live
                                    // through response formatting, including an occupied empty value.
                                    if request.command == 1 {
                                        store_result = 2
                                        if match_index != slot_count {
                                            store_result = 1
                                        }
                                    }
                                    // A SET validates its entire value before any destination byte write.
                                    if request.command == 2 {
                                        let value_in_range = store.range_fits(core.prefix(pending.wire, filled), request.value_offset, request.value_length)
                                        if value_in_range == 1 {
                                            if request.value_length <= value_capacity {
                                                // Prefer an overwrite even if every slot is occupied.
                                                var destination_index = match_index
                                                if destination_index == slot_count {
                                                    destination_index = free_index
                                                }
                                                store_result = 3
                                                if destination_index != slot_count {
                                                    let destination = core.borrow_readwrite(entries, destination_index)
                                                    // The constructor initialized these fixed capacities
                                                    // and the range checks prove the source byte accesses.
                                                    if destination.occupied == 0 {
                                                        for byte in core.range(request.key_length) {
                                                            destination.key[byte] = pending.wire[core.add_wrapping(request.key_offset, byte)]
                                                        }
                                                        destination.key_length = request.key_length
                                                    }
                                                    // Existing keys stay in place. Shrinking a value leaves
                                                    // an inaccessible stale tail outside the new prefix.
                                                    for byte in core.range(request.value_length) {
                                                        destination.value[byte] = pending.wire[core.add_wrapping(request.value_offset, byte)]
                                                    }
                                                    destination.value_length = request.value_length
                                                    destination.occupied = 1
                                                    store_result = 0
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Choose the reply after the table operation completes.
                            sent = 0
                            if store_result == 0 {
                                reply.wire[0] = 43
                                reply.wire[1] = 79
                                reply.wire[2] = 75
                                reply.wire[3] = 13
                                reply.wire[4] = 10
                                reply_length = 5
                            }
                            if store_result == 1 {
                                let hit = core.borrow_readonly(entries, match_index)
                                let length = hit.value_length
                                core.assert(length <= value_capacity)
                                var header = 1
                                var digits = length
                                reply.wire[0] = 36
                                // The 128-byte profile needs at most one hundreds digit.
                                if digits >= 100 {
                                    reply.wire[header] = 49
                                    header = core.add_wrapping(header, 1)
                                    digits = core.sub_wrapping(digits, 100)
                                }
                                var tens = 0
                                // Bounded subtraction yields the tens and ones.
                                for digit in core.range(9) {
                                    if digits >= 10 {
                                        tens = core.add_wrapping(tens, 1)
                                        digits = core.sub_wrapping(digits, 10)
                                    }
                                }
                                if length >= 10 {
                                    reply.wire[header] = core.add_wrapping(48, tens)
                                    header = core.add_wrapping(header, 1)
                                }
                                reply.wire[header] = core.add_wrapping(48, digits)
                                reply.wire[core.add_wrapping(header, 1)] = 13
                                reply.wire[core.add_wrapping(header, 2)] = 10
                                let start = core.add_wrapping(header, 3)
                                // Only the committed logical value is serialized.
                                for byte in core.range(length) {
                                    reply.wire[core.add_wrapping(start, byte)] = hit.value[byte]
                                }
                                let end = core.add_wrapping(start, length)
                                reply.wire[end] = 13
                                reply.wire[core.add_wrapping(end, 1)] = 10
                                reply_length = core.add_wrapping(end, 2)
                            }
                            if store_result == 2 {
                                reply.wire[0] = 36
                                reply.wire[1] = 45
                                reply.wire[2] = 49
                                reply.wire[3] = 13
                                reply.wire[4] = 10
                                reply_length = 5
                            }
                            if store_result == 3 {
                                reply_error = 5
                            }
                            if store_result == 4 {
                                reply_error = 3
                                close_after_reply = 1
                            }
                        } else {
                            // Complete terminal errors get one reply. An
                            // incomplete status leaves the input tail live.
                            if outcome >= 2048 {
                                core.assert(outcome <= 2050)
                                read_needed = 0
                                close_after_reply = 1
                                reply_error = core.sub_wrapping(outcome, 2046)
                            }
                        }
                    }
                    if read_needed == 1 {
                        // Moving the tail left in increasing order preserves
                        // every input byte even when the ranges overlap.
                        if cursor > 0 {
                            let tail = core.sub_wrapping(filled, cursor)
                            for byte in core.range(tail) {
                                pending.wire[byte] = pending.wire[core.add_wrapping(cursor, byte)]
                            }
                            filled = tail
                            cursor = 0
                        }
                        if filled == wire_capacity {
                            close_after_reply = 1
                            reply_error = 3
                        } else {
                            let room = core.sub_wrapping(wire_capacity, filled)
                            refill incoming.wire, room as chunk {
                                let received = chunk_length(chunk)
                                // Copy only the exact initialized received prefix.
                                for byte in core.range(received) {
                                    pending.wire[core.add_wrapping(filled, byte)] = chunk_byte(chunk, byte)
                                }
                                filled = core.add_wrapping(filled, received)
                            } else status {
                                if status == 0 {
                                    // A half-closed peer can still read the truncation reply.
                                    if filled == 0 {
                                        session_finished = 1
                                    } else {
                                        close_after_reply = 1
                                        reply_error = 1
                                    }
                                } else {
                                    if status == would_block {
                                        let ready = core.wait_input()
                                        if ready != 0 {
                                            if ready != interrupted {
                                                session_finished = 1
                                            }
                                        }
                                    } else {
                                        if status != interrupted {
                                            session_finished = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // A single bounded simple-error frame covers parse and
                    // store failures. Only fatal framing closes the connection.
                    if reply_error != 0 {
                        reply.wire[0] = 45
                        reply.wire[1] = 69
                        reply.wire[2] = 82
                        reply.wire[3] = 82
                        reply.wire[4] = 32
                        reply.wire[5] = core.add_wrapping(48, reply_error)
                        reply.wire[6] = 13
                        reply.wire[7] = 10
                        sent = 0
                        reply_length = 8
                    }
                }
            }
        }
    }
}

// Observe only the extent that the native adapter lent for the current read.
func chunk_length
    with noalloc, noblock
    arg input Bytes as readonly reference
    returns u64
{
    return core.len(input)
}

// Copy one byte from a checked readonly view without retaining it.
func chunk_byte
    with noalloc, noblock
    arg input Bytes as readonly reference
    arg index u64 as readonly copy
    returns u64
{
    return input[index]
}
