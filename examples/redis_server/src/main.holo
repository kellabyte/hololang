// Bounded RESP2 GET and SET server. The checked parser commits scalar request
// extents, the table owns copied keys and values, and the entry sends replies
// over a host-owned connected stream. Each stage uses finite backing.

using holo.bytes
using holo.bytes.write
using holo.buffer
using holo.decimal
using holo.net
using redis_server.store

// Parse a bounded RESP2 GET or SET request from the caller's live byte
// prefix. The parser never copies payloads or keeps a borrowed view. It
// publishes copied offsets in one fixed record only after the complete
// request passes length, delimiter, command, and arity checks.

enum Command {
    Unset
    Get
    Set
}

// Completed request metadata in the caller's reusable record.
struct Request {
    // Unset until the parser publishes its first complete request.
    command Command
    // Wire bytes consumed starting from the request's first byte.
    consumed u64
    // Absolute offset in the supplied byte view of the validated key.
    key_offset u64
    // Binary key length, including the possibility of an empty key.
    key_length u64
    // Absolute value offset for SET, or zero for GET.
    value_offset u64
    // Binary value length for SET, or zero for GET.
    value_length u64
}
// Initialize one metadata record at its receiving destination. The caller
// keeps this storage across requests. There is no variable-sized field.
func empty_request
    with noblock
    returns Request
{
    return Request {
        command: Command.Unset,
        consumed: 0,
        key_offset: 0,
        key_length: 0,
        value_offset: 0,
        value_length: 0
    }
}

// An incomplete request carries the next absolute wire extent. The remaining
// cases distinguish malformed framing, preview size limits, and u64 overflow.
error RequestError {
    NeedMore(required u64)
    Malformed
    OverLimit
    Overflow
}

// Read a canonical unsigned decimal header after the expected marker. Return
// the value after validating CRLF. The request parser checks the context's
// size limit before it uses the value to form any payload offsets.
func request_decimal
    with noalloc, noblock
    arg wire Bytes as readonly reference
    arg start u64 as readonly copy
    arg marker u64 as readonly copy
    returns Result<u64, RequestError>
{
    let extent = core.len(wire)
    // An empty suffix can acquire the marker on the next read.
    if start >= extent {
        return error RequestError.NeedMore(core.add_wrapping(start, 1))
    }
    if wire[start] != marker {
        return error RequestError.Malformed
    }
    let first = start + 1
    if first == extent {
        return error RequestError.NeedMore(core.add_wrapping(extent, 1))
    }
    var length = extent - first
    // Twenty digits exhaust u64. The following byte must be CR or establish
    // a terminal decimal error, so the search can stop at that position.
    if length > 21 {
        length = 21
    }
    let line = core.subrange(wire, first, length)
    let digits = bytes.find(line, 13)
        on Some(index) then index
        on None then length
    decimal.parse_u64(core.prefix(line, digits))
        on ok(value) then {
            // Validate the available digits even when CR has yet to arrive.
            if digits == length {
                return error RequestError.NeedMore(core.add_wrapping(extent, 1))
            }
            let line_end = core.add_wrapping(core.add_wrapping(first, digits), 1)
            if line_end == extent {
                return error RequestError.NeedMore(core.add_wrapping(extent, 1))
            }
            if wire[line_end] != 10 {
                return error RequestError.Malformed
            }
            return ok value
        }
        on NeedTerminator then {
            core.assert(false)
            return error RequestError.Malformed
        }
        on Malformed then {
            return error RequestError.Malformed
        }
        on Overflow then {
            return error RequestError.Overflow
        }
}

// Check a bulk string's body extent and trailing CRLF, then return its payload
// offset. Length is already validated and at most 128. Its canonical decimal
// width avoids a second scan. Body bytes can be arbitrary.
func request_bulk_payload
    with noalloc, noblock
    arg wire Bytes as readonly reference
    arg header u64 as readonly copy
    arg length u64 as readonly copy
    returns Result<u64, RequestError>
{
    // A validated header is dollar, one to three digits, and CRLF.
    let payload = header + decimal.digit_count(length) + 3
    let ending = payload + length
    let next = ending + 2
    let extent = core.len(wire)
    // Inspect the first trailer byte as soon as it is live. A malformed
    // partial trailer can therefore fail before the next byte arrives.
    if ending < extent and wire[ending] != 13 {
        return error RequestError.Malformed
    }
    if extent < next {
        return error RequestError.NeedMore(next)
    }
    if wire[ending + 1] != 10 {
        return error RequestError.Malformed
    }
    return ok payload
}

// Parse one request starting at an absolute position in the live view. Keep
// request untouched on every failure. Success returns the positive consumed
// extent (1–512) and publishes absolute key and value offsets in the supplied
// record. It performs no I/O, allocation, payload copy, or retained borrow.
func parse_request
    with noalloc, noblock
    arg request Request as readwrite reference
    arg wire Bytes as readonly reference
    arg start u64 as readonly copy
    returns Result<u64, RequestError>
{
    let extent = core.len(wire)
    // A bounded view limits all cursor arithmetic independently of declared
    // wire lengths. A caller may parse an empty suffix at exactly extent.
    if extent > 512 {
        return error RequestError.OverLimit
    }
    if start > extent {
        return error RequestError.Malformed
    }
    let count = try request_decimal(wire, start, 42)
    // Only the canonical one-digit array counts of GET and SET are admitted.
    if count < 2 or count > 3 {
        return error RequestError.Malformed
    }
    let command_header = start + 4
    let command_length = try request_decimal(wire, command_header, 36)
    // Both commands have exactly three bytes and the same framing overhead.
    if command_length != core.len(b"GET") {
        return error RequestError.Malformed
    }
    let command_start = try request_bulk_payload(wire, command_header, command_length)
    let name = core.subrange(wire, command_start, command_length)
    var command = Command.Get
    if count == 3 {
        if not bytes.equal_ignore_ascii_case(name, b"SET") {
            return error RequestError.Malformed
        }
        command = Command.Set
    } else {
        if not bytes.equal_ignore_ascii_case(name, b"GET") {
            return error RequestError.Malformed
        }
    }

    let key_header = command_start + 5
    let key_length = try request_decimal(wire, key_header, 36)
    if key_length > 32 {
        return error RequestError.OverLimit
    }
    // Validate key framing before computing the value's header offset.
    let key_offset = try request_bulk_payload(wire, key_header, key_length)
    let after_key = key_offset + key_length + 2
    var value_offset = 0
    var value_length = 0
    var after_request = after_key
    // SET admits exactly one value. GET publishes zero in both value fields.
    if command == Command.Set {
        let parsed_length = try request_decimal(wire, after_key, 36)
        if parsed_length > 128 {
            return error RequestError.OverLimit
        }
        let parsed_offset = try request_bulk_payload(wire, after_key, parsed_length)
        value_length = parsed_length
        value_offset = parsed_offset
        after_request = parsed_offset + parsed_length + 2
    }

    // Every body and trailer has been validated. Publish together at this
    // boundary so incomplete and terminal errors cannot alter caller state.
    let consumed = after_request - start
    request.command = command
    request.consumed = consumed
    request.key_offset = key_offset
    request.key_length = key_length
    request.value_offset = value_offset
    request.value_length = value_length
    return ok consumed
}

// Encode the typed outcome for the offline replay protocol.
// Only a successful parse publishes a new request descriptor.
func parse_request_status
    with noalloc, noblock
    arg request Request as readwrite reference
    arg wire Bytes as readonly reference
    arg start u64 as readonly copy
    returns u64
{
    return parse_request(request, wire, start)
        on ok(consumed) then consumed
        on NeedMore(required) then core.add_wrapping(1024, required)
        on Malformed then 2048
        on OverLimit then 2049
        on Overflow then 2050
}

// The parser declarations above also serve the offline conformance driver.

// Preserve the writer's typed failures across the frame builder.
error ReplyError {
    from write.WriteError as Write
}

// Format one committed value as a RESP bulk reply in the reusable output slot.
// The preview reserves enough room for a three-digit length, 128 bytes, and framing.
func write_bulk_reply
    with noalloc, noblock
    arg writer write.Cursor as readwrite reference
    arg reply Bytes as readwrite reference
    arg value Bytes as readonly reference
    returns Result<u64, ReplyError>
{
    let length = core.len(value)
    core.assert(length <= 128)
    let readwrite output = core.prefix(reply, core.add_wrapping(length, 8))
    writer.position = 0
    let _marker = try write.put_u8(writer, output, 36)
    let _digits = try write.put_decimal(writer, output, length)
    let _header_end = try write.put_bytes(writer, output, b"\r\n")
    let _payload = try write.put_bytes(writer, output, value)
    let _trailer = try write.put_bytes(writer, output, b"\r\n")
    return ok writer.position
}

// Buffers remain initialized and retain their physical extent across requests.
// Logical input/output cursors separately delimit the valid bytes.
struct WireSlot {
    // Inline byte capacity, filled once during owner setup.
    wire Bytes
}

// Construct one initialized buffer directly in its long-lived receiving slot.
func wire_slot
    arg capacity u64 as readonly copy
    returns WireSlot
{
    return WireSlot {
        wire: core.bytes(capacity, 0)
    }
}

// Serve one connected stream at a time while keeping the table alive for the
// whole entry. No request acquires backing. Short I/O and per-client parsing
// state live in scalars, and replies finish before input can reuse the buffers.
func main
    returns u64
{
    let wire_capacity = 512
    let key_capacity = 32
    let value_capacity = 128
    let entries_capacity = 16

    let buffers_memory = core.region(1024) else {
        core.assert(false);
        return 0
    }
    let buffers = core.batch(buffers_memory, WireSlot)
    let pending_status = core.append(buffers, wire_slot(wire_capacity))
    // A maximum bulk reply has six header bytes, 128 data bytes, and CRLF.
    let output_status = core.append(buffers, wire_slot(136))
    core.assert(pending_status == 0)
    core.assert(output_status == 0)
    let pending = core.borrow_readwrite(buffers, 0)
    let reply = core.borrow_readwrite(buffers, 1)

    let writer_memory = core.region(16) else {
        core.assert(false)
        return 0
    }
    core.construct(writer_memory, write.start())
        on ok(readwrite writer) then {
            let request_memory = core.region(64) else {
                core.assert(false);
                return 0
            }
            core.construct(request_memory, empty_request())
                on ok(readwrite request) then {
                    let table_memory = core.region(4096) else {
                        core.assert(false);
                        return 0
                    }
                    let entries = core.batch(table_memory, store.Slot)
                    // Initialize all slots once. Updates mutate a checked prefix in place.
                    for index in core.range(entries_capacity) {
                        let status = core.append(entries, store.empty_slot(key_capacity, value_capacity))
                        core.assert(status == 0)
                    }

                    var filled = 0
                    var cursor = 0
                    var sent = 0
                    var reply_length = 0
                    var close_after_reply = false
                    var session_finished = false
                    loop {
                        // Advancing the session discards only stream state. A prior SET
                        // remains committed even if the peer never read its reply.
                        if session_finished {
                            let next = core.next_session()
                            net.next_session_result(next)
                                on ok then {
                                    filled = 0
                                    cursor = 0
                                    sent = 0
                                    reply_length = 0
                                    close_after_reply = false
                                    session_finished = false
                                }
                                on Interrupted then {
                                    // Keep the session finished so the loop retries accept.
                                }
                                on End then {
                                    break
                                }
                                on error then {
                                    // A failed accept leaves no client to serve.
                                    break
                                }
                            continue
                        }

                        // A partially written reply owns the output slot until all its
                        // bytes are accepted or the session terminates.
                        if sent < reply_length {
                            let reply_bytes = core.prefix(reply.wire, reply_length)
                            let remaining = core.sub_wrapping(core.len(reply_bytes), sent)
                            let outcome = core.send(reply_bytes, sent, remaining)
                            net.send_result(outcome)
                                on ok(count) then {
                                    sent = core.add_wrapping(sent, count)
                                }
                                on Interrupted then {
                                    // Retry from the same send offset.
                                }
                                on WouldBlock then {
                                    let ready = core.wait_output()
                                    net.wait_result(ready)
                                        on ok then {
                                        }
                                        on Interrupted then {
                                        }
                                        on error then {
                                            session_finished = true
                                        }
                                }
                                on error then {
                                    session_finished = true
                                }
                            continue
                        }
                        if close_after_reply {
                            session_finished = true
                            continue
                        }

                        // Bytes before cursor belong to completed requests. Keep
                        // all pending bytes in place unless a new read needs room.
                        if cursor == filled {
                            cursor = 0
                            filled = 0
                        }
                        var read_needed = true
                        var reply_error = 0
                        if cursor < filled {
                            let pending_input = core.prefix(pending.wire, filled)
                            parse_request(request, pending_input, cursor)
                                on ok(consumed) then {
                                    core.assert(consumed > 0)
                                    read_needed = false
                                    cursor = core.add_wrapping(cursor, consumed)

                                    let key = core.subrange(pending_input, request.key_offset, request.key_length)
                                    sent = 0
                                    if request.command == Command.Get {
                                        let match_index = store.find(entries, key)
                                        match_index
                                            on Some(index) then {
                                                let hit = core.borrow_readonly(entries, index)
                                                write_bulk_reply(writer, reply.wire, core.prefix(hit.value, hit.value_length))
                                                    on ok(length) then {
                                                        reply_length = length
                                                    }
                                                    on error then {
                                                        core.assert(false)
                                                    }
                                            }
                                            on None then {
                                                reply_length = bytes.move(reply.wire, b"$-1\r\n")
                                            }
                                    } else {
                                        core.assert(request.command == Command.Set)
                                        let value = core.subrange(pending_input, request.value_offset, request.value_length)
                                        store.put(entries, key, value)
                                            on ok then {
                                                reply_length = bytes.move(reply.wire, b"+OK\r\n")
                                            }
                                            on Full then {
                                                reply_error = 5
                                            }
                                            on OverLimit then {
                                                reply_error = 3
                                                close_after_reply = true
                                            }
                                    }
                                }
                                on NeedMore(required) then {
                                    core.assert(required > filled)
                                }
                                on Malformed then {
                                    read_needed = false
                                    close_after_reply = true
                                    reply_error = 2
                                }
                                on OverLimit then {
                                    read_needed = false
                                    close_after_reply = true
                                    reply_error = 3
                                }
                                on Overflow then {
                                    read_needed = false
                                    close_after_reply = true
                                    reply_error = 4
                                }
                        }
                        if read_needed {
                            // The unread tail may overlap its destination at the start of the slot.
                            if cursor > 0 {
                                filled = buffer.compact(pending.wire, cursor, filled)
                                cursor = 0
                            }
                            let room = buffer.space(pending.wire, filled)
                            if room == 0 {
                                close_after_reply = true
                                reply_error = 3
                            } else {
                                let readwrite free_tail = core.subrange(pending.wire, filled, room)
                                refill free_tail, room as chunk {
                                    filled = core.add_wrapping(filled, core.len(chunk))
                                } else status {
                                    net.recv_result(status)
                                        on ok(count) then {
                                            // Only EOF reaches this arm. Progress goes to chunk.
                                            core.assert(count == 0)
                                            // A half-closed peer can still read the truncation reply.
                                            if filled == 0 {
                                                session_finished = true
                                            } else {
                                                close_after_reply = true
                                                reply_error = 1
                                            }
                                        }
                                        on Interrupted then {
                                        }
                                        on WouldBlock then {
                                            let ready = core.wait_input()
                                            net.wait_result(ready)
                                                on ok then {
                                                }
                                                on Interrupted then {
                                                }
                                                on error then {
                                                    session_finished = true
                                                }
                                        }
                                        on error then {
                                            session_finished = true
                                        }
                                }
                            }
                        }
                        // A single bounded simple-error frame covers parse and
                        // store failures. Only fatal framing closes the connection.
                        if reply_error != 0 {
                            let prefix = bytes.move(reply.wire, b"-ERR ")
                            reply.wire[prefix] = core.add_wrapping(48, reply_error)
                            let ending = core.add_wrapping(prefix, 1)
                            let trailer = bytes.move(core.subrange(reply.wire, ending, core.len(b"\r\n")), b"\r\n")
                            sent = 0
                            reply_length = core.add_wrapping(ending, trailer)
                        }
                    }
                }
                on error then {
                    core.assert(false)
                }
        }
        on error then {
            core.assert(false)
        }
    return 0
}
